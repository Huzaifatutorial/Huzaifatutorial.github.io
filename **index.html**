.btns{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}
.btn{display:inline-block;padding:12px 22px;border-radius:999px;text-decoration:none;font-weight:600;border:2px solid var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink)}
