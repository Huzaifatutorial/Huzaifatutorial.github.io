.flow h2{font-size:1.05rem;margin-bottom:4px}
.flow small{color:var(--muted);display:block;margin-bottom:18px}
.chain{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
.node{border:2px solid var(--line);border-radius:12px;padding:10px 14px;display:flex;justify-content:space-between;gap:12px;animation:glow 6s infinite}
.node b{font-weight:600}
.node span{color:var(--muted);font-size:.92rem}
.link{width:2px;height:16px;background:var(--line);margin:0 0 0 28px}
.node:nth-child(3){animation-delay:1.2s}.node:nth-child(5){animation-delay:2.4s}.node:nth-child(7){animation-delay:3.6s}
@keyframes glow{0%,22%,100%{border-color:var(--line)}6%,16%{border-color:var(--accent)}}
section{padding:46px 0;border-top:1px solid var(--line)}
section>.wrap>h2{font-size:clamp(1.7rem,4vw,2.3rem);margin-bottom:22px}
.about{display:grid;grid-template-columns:1fr 1fr;gap:34px}
.about p{margin:0 0 14px;max-width:36em}
.facts{margin:0;padding:0;list-style:none}
.facts li{padding:10px 0;border-bottom:1px solid var(--line)}
.facts li:last-child{border:0}
.facts b{display:block}
.facts span{color:var(--muted);font-size:.95rem}
.feat{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:34px}
.paper{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:26px}
.paper h3{font-size:1.35rem;margin-bottom:8px}
.big{font-family:Georgia,serif;font-size:2.4rem;font-weight:700;letter-spacing:-.02em;margin:10px 0 2px}
.big em{font-style:normal;color:var(--muted);font-size:1.3rem;padding:0 6px}
.big strong{color:var(--accent)}
.paper p{margin:8px 0;color:var(--muted)}
.tools{font-size:.92rem;color:var(--mint);font-weight:600;margin-top:12px}
.rows h3{font-size:1.3rem;margin-bottom:16px}
.row{display:grid;grid-template-columns:230px 1fr;gap:22px;padding:18px 0;border-top:1px solid var(--line)}
.row b{font-size:1.05rem;display:block}
.row small{color:var(--mint);font-weight:600;display:block;margin-top:2px;font-size:.88rem}
.row p{margin:0;color:var(--muted)}
