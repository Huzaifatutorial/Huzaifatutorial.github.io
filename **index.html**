<style>
:root{--bg:#eef2f7;--surface:#ffffff;--ink:#14213d;--muted:#52607a;--line:#cdd6e4;--accent:#2f5bea;--accent-ink:#ffffff;--mint:#0e8f78;color-scheme:light;
