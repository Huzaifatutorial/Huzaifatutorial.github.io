.skills div{padding:12px 0;border-bottom:1px solid var(--line)}
.skills b{display:block;margin-bottom:2px}
.skills span{color:var(--muted)}
.contact p{max-width:34em;color:var(--muted);margin:0 0 22px}
footer{padding:30px 0 40px;color:var(--muted);font-size:.9rem;border-top:1px solid var(--line)}
.hero{position:relative}
.hero::before{content:"";position:absolute;inset:0 -22px;background-image:radial-gradient(var(--line) 1px,transparent 1.3px);background-size:22px 22px;opacity:.7;-webkit-mask-image:linear-gradient(#000,transparent);mask-image:linear-gradient(#000,transparent);z-index:-1}
.skills b{font-family:Georgia,"Iowan Old Style",serif;font-size:1.12rem}
.learn{margin:0;padding:0;list-style:none}
.learn li{padding:10px 0;border-bottom:1px solid var(--line)}
.learn li:last-child{border:0}
.learn b{color:var(--mint)}
@media (max-width:760px){
.hero,.about,.feat,.skills{grid-template-columns:1fr}
.row{grid-template-columns:1fr;gap:6px}
.hero{padding:34px 0 44px}
}
@media (prefers-reduced-motion:reduce){.node{animation:none}}
